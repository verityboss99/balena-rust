<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Balena Ltd.</vendor>
  <vendor_url>https://etcher.balena.io/</vendor_url>
  <icon_name>balena-etcher</icon_name>
  <action id="io.balena.etcher.flash">
    <description>Flash OS images to drives</description>
    <message>Authentication is required to flash a drive with balenaEtcher</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/balena-etcher/etcher-util</annotate>
  </action>
</policyconfig>
